# Identity Verification Platform — environment contract. Copy to .env (never commit .env).
AION_ENVIRONMENT=development
# Field-level encryption keys (base64). Managed by KMS/HSM in production.
IDENTITY_ENC_CURRENT_KEY=k1
IDENTITY_ENC_KEY_k1=
# Verification provider (licensed). Secrets via env only.
IDENTITY_PROVIDER=
IDENTITY_PROVIDER_API_KEY=
IDENTITY_PROVIDER_WEBHOOK_SECRET=
# Telemetry sink
AION_TELEMETRY_URL=
