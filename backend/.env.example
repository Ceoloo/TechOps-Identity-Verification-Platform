# ---------------------------------------------------------------------------
# TechOps Identity Verification Platform — backend environment template
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Standard libpq connection string. Used by the app and the migration runner.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/techops_kyc

# Optional discrete parts (used only if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=techops_kyc

# --- Field-level encryption -------------------------------------------------
# 32-byte key, base64-encoded, used for AES-256-GCM field encryption of PII
# and per-business provider API keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate by adding a new key id; see docs/README.md.
PII_ENCRYPTION_KEY=

# Key id/version label stored alongside ciphertext to support key rotation.
PII_ENCRYPTION_KEY_ID=k1

# --- App --------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Set to "sandbox" to force all verification provider adapters into mock mode
# regardless of per-business config (safe default for local dev).
PROVIDER_MODE=sandbox

# --- Public intake rate limiting (Phase 4) ----------------------------------
INTAKE_RATE_WINDOW_MS=60000
INTAKE_RATE_MAX=10

# Express trust-proxy setting for correct client IP behind a load balancer.
# e.g. "loopback", "1" (one hop), or a specific subnet.
TRUST_PROXY=loopback
